# ==============================================================================
# VENUS Water Management - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Variables (Vite - exposed to client browser)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional custom Edge Function endpoint if deployed on custom domain/path
VITE_SUPABASE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1/submit-enquiry

# ------------------------------------------------------------------------------
# Backend & Edge Function Secrets (NEVER expose to frontend)
# Configured in Supabase Dashboard -> Project Settings -> Edge Functions Secrets
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend Email Integration
RESEND_API_KEY=re_1234567890abcdef
RESEND_SENDER_EMAIL=enquiries@venuswater.com
COMPANY_ADMIN_EMAIL=admin@venuswater.com

# Twilio SMS Integration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Integration (https://fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Fast2SMS Integration (https://fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
